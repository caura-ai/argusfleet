# Copy to .env and fill in. .env is gitignored.

# Memory server (system under test)
MEMCLAW_BASE_URL=https://memclaw.net
MEMCLAW_API_KEY=

# Tenant your API key is authorised to target. The server's
# ``auth.enforce_tenant`` rejects writes whose tenant_id doesn't match
# the key's scope with a 403, so this MUST be set unless your key is an
# admin/superuser key that bypasses the check.
#
# Single tenant:
#   MEMCLAW_TENANT_ID=mc_your_tenant_id
# Multiple tenants (only useful for cross-tenant leakage testing — comma
# separated, no spaces required):
#   MEMCLAW_TENANT_ID=mc_tenant_a,mc_tenant_b
MEMCLAW_TENANT_ID=

# Harness overrides (optional)
# ARGUSFLEET_SEED=42
# ARGUSFLEET_RUN_LABEL=baseline
# ARGUSFLEET_OUTPUT_DIR=./outputs
